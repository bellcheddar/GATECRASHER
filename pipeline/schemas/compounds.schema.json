{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gatecrasher/compounds.schema.json",
  "title": "compounds.csv rows",
  "description": "One row per compound: published identity plus RDKit-computed properties. Validated after gc chem has filled in the computed columns.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["compound_id", "label", "series", "role", "smiles", "inchikey", "mw", "clogp", "tpsa", "hbd", "hba", "rotb", "hac", "fsp3", "depiction", "source_table"],
    "additionalProperties": false,
    "properties": {
      "compound_id": { "type": "string", "minLength": 1, "description": "The published compound number, never renumbered." },
      "label": { "type": "string" },
      "series": { "type": "string" },
      "role": { "enum": ["reference", "hit", "intermediate", "milestone", "lead", "tool"] },
      "smiles": { "type": "string", "minLength": 5 },
      "inchikey": { "type": "string", "pattern": "^[A-Z]{14}-[A-Z]{10}-[A-Z]$" },
      "r_groups": {
        "type": "object",
        "description": "Keyed by the R-position label used in that paper's own table.",
        "additionalProperties": {
          "type": "object",
          "required": ["label", "smiles"],
          "additionalProperties": false,
          "properties": {
            "label": { "type": "string" },
            "smiles": { "type": "string" }
          }
        }
      },
      "mw": { "type": "number", "exclusiveMinimum": 0 },
      "clogp": { "type": "number" },
      "tpsa": { "type": "number", "minimum": 0 },
      "hbd": { "type": "integer", "minimum": 0 },
      "hba": { "type": "integer", "minimum": 0 },
      "rotb": { "type": "integer", "minimum": 0 },
      "hac": { "type": "integer", "exclusiveMinimum": 0 },
      "fsp3": { "type": "number", "minimum": 0, "maximum": 1 },
      "depiction": { "type": "string", "pattern": "\\.svg$" },
      "mol3d": { "type": ["string", "null"] },
      "source_table": { "type": "string", "minLength": 2, "description": "Published table or figure the identity came from, for example T1 or Fig2." },
      "notes": { "type": ["string", "null"] }
    }
  }
}
